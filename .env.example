# Modelo de embeddings (local, roda em CPU)
EMBED_MODEL=intfloat/multilingual-e5-small

# Provedor do LLM: transformers (local, padrão) | ollama | openai_compat | none
LLM_PROVIDER=transformers
# transformers -> id do Hugging Face | ollama -> nome do modelo (ex.: qwen2.5:3b) | openai_compat -> id do modelo
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct

# Apenas para LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434

# Apenas para LLM_PROVIDER=openai_compat (qualquer API compatível com OpenAI: Groq, OpenRouter, LM Studio...)
OPENAI_BASE_URL=
OPENAI_API_KEY=
